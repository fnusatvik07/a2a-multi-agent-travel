# Copy to .env and fill in. Every service reads this one file.

# --- Model access -----------------------------------------------------------
# All five agents call the same model, so any behavioural difference you see
# between them comes from the framework, not the model.
OPENAI_API_KEY=sk-...
ATLASTRIP_MODEL=gpt-4.1-mini

# Set to "deterministic" to run the network without calling a model at all.
# Each agent then executes its own service layer directly. The test suite uses
# this so it can run offline and for free.
ATLASTRIP_REASONING=llm

# --- Storage ----------------------------------------------------------------
# Matches docker-compose.yml. Point this anywhere if you bring your own Postgres.
ATLASTRIP_POSTGRES_DSN=postgresql://atlastrip:atlastrip@127.0.0.1:5433/atlastrip

# --- Network ----------------------------------------------------------------
ATLASTRIP_HOST=127.0.0.1
ATLASTRIP_MCP_URL=http://127.0.0.1:8100/mcp
ATLASTRIP_LOG_LEVEL=INFO
