t"/><mxPoint x="1160" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="Konan Garden Hotel, $189.96 a night" style="html=1;rounded=0;strokeColor=#B7791F;strokeWidth=1.6;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1160" y="690" as="sourcePoint"/><mxPoint x="670" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n24" value="screen_trip" style="html=1;rounded=0;strokeColor=#2F855A;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="750" as="sourcePoint"/><mxPoint x="1380" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n25" value="within policy, manager approval required" style="html=1;rounded=0;strokeColor=#2F855A;strokeWidth=1.6;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1380" y="795" as="sourcePoint"/><mxPoint x="670" y="795" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n26" value="authorize_spend  $3,688.76" style="html=1;rounded=0;strokeColor=#B83280;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="855" as="sourcePoint"/><mxPoint x="1610" y="855" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n27" value="input-required: a human must sign this off" style="html=1;rounded=0;strokeColor=#B83280;strokeWidth=1.6;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="900" as="sourcePoint"/><mxPoint x="670" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n28" value="input-required: approve $3,688.76?" style="html=1;rounded=0;strokeColor=#4C51BF;strokeWidth=1.6;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="945" as="sourcePoint"/><mxPoint x="420" y="945" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n29" value="approve" style="html=1;rounded=0;strokeColor=#4C51BF;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="990" as="sourcePoint"/><mxPoint x="670" y="990" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n30" value="same task id, with the approval token" style="html=1;rounded=0;strokeColor=#B83280;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670" y="1025" as="sourcePoint"/><mxPoint x="1610" y="1025" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n31" value="approved, AUTH-351693FF2A, committed" style="html=1;rounded=0;strokeColor=#B83280;strokeWidth=1.6;endArrow=open;endFill=0;endSize=7;dashed=1;dashPattern=6 4;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=bottom;align=center" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1610" y="1055" as="sourcePoint"/><mxPoint x="670" y="1055" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n32" value="&lt;b&gt;The negotiation&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Hearth used its judgement, Sentinel overruled it, and the Concierge asked again rather than deciding for either of them.&lt;br/&gt;&lt;br/&gt;It reads the cap out of Sentinel's finding. It holds no copy of the policy." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#5A6675;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=left;fontSize=11;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="560" width="250" height="170" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;The interrupt&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Ledger pauses its task. The Concierge pauses its own.&lt;br/&gt;&lt;br/&gt;The question reaches the person who can answer it without any agent in the chain special-casing the others." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#5A6675;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=left;fontSize=11;verticalAlign=top;spacing=10" vertex="1" parent="1"><mxGeometry x="60" y="850" width="250" height="170" as="geometry"/></mxCell><mxCell id="n34" value="Solid arrows are requests.&amp;nbsp;&amp;nbsp;Dashed arrows are what came back." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="1120" width="700" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Task lifecycle"><mxGraphModel dx="1180" dy="780" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="The A2A task lifecycle" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="40" width="700" height="34" as="geometry"/></mxCell><mxCell id="n2" value="Every agent on this network moves its tasks through these states." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="74" width="900" height="22" as="geometry"/></mxCell><mxCell id="n3" value="IN FLIGHT" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1;align=left" vertex="1" parent="1"><mxGeometry x="60" y="150" width="120" height="20" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b style='font-size:13px'&gt;submitted&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;The Task object itself, enqueued before anything else.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0AEC0;fontColor=#1A202C;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="60" y="180" width="210" height="96" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b style='font-size:13px'&gt;working&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;Status updates carry progress the caller can show a human.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#4C51BF;fontColor=#2A2F86;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="420" y="180" width="210" height="96" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b style='font-size:13px'&gt;input-required&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;Paused, not failed. A human has to answer something.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECF2;strokeColor=#B83280;fontColor=#8B2160;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="780" y="180" width="210" height="96" as="geometry"/></mxCell><mxCell id="n7" value="TERMINAL" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1;align=left" vertex="1" parent="1"><mxGeometry x="60" y="420" width="120" height="20" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b style='font-size:13px'&gt;rejected&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;The request itself was wrong.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2E3;strokeColor=#B7791F;fontColor=#8A5A12;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="60" y="450" width="210" height="96" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b style='font-size:13px'&gt;failed&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;The request was fine; the work could not be done.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2E3;strokeColor=#B7791F;fontColor=#8A5A12;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="300" y="450" width="210" height="96" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b style='font-size:13px'&gt;completed&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;An artifact was published. Nothing more may be sent.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F6EC;strokeColor=#2F855A;fontColor=#1F5F40;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="540" y="450" width="210" height="96" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b style='font-size:13px'&gt;canceled&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;line-height:1.4'&gt;The caller gave up, or abandoned a waiting task.&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#4A5568;fontColor=#2D3748;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=center" vertex="1" parent="1"><mxGeometry x="780" y="450" width="210" height="96" as="geometry"/></mxCell><mxCell id="n12" value="start_work()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C51BF;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="requires_input()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B83280;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=1;exitY=0.32;exitDx=0;exitDy=0;entryX=0;entryY=0.32;entryDx=0;entryDy=0" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="a second message,
same task id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B83280;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;dashed=1;dashPattern=6 4;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="reject()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="failed()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="complete()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="cancel()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5568;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=7;fontFamily=Helvetica;fontSize=10;fontColor=#1A202C;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Where each one shows up in AtlasTrip&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;input-required&lt;/b&gt;&amp;nbsp;&amp;nbsp;Ledger, when the spend needs a human. The Concierge then does the same on its own task, so the question reaches the person who can answer it.&lt;br/&gt;&lt;b&gt;rejected&lt;/b&gt;&amp;nbsp;&amp;nbsp;A brief that fails validation. The caller was wrong, so the task is rejected rather than failed.&lt;br/&gt;&lt;b&gt;failed&lt;/b&gt;&amp;nbsp;&amp;nbsp;A route with no inventory. The request was fine; the work could not be done." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontColor=#5A6675;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;align=left;verticalAlign=top;fontSize=11;spacing=12" vertex="1" parent="1"><mxGeometry x="60" y="610" width="1060" height="118" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>