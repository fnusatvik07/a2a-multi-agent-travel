=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B6CB0;strokeWidth=1.2;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n11" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B7791F;strokeWidth=1.2;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n13" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F855A;strokeWidth=1.2;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n15" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B83280;strokeWidth=1.2;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n17" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5568;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n19" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4A5568;strokeWidth=1.6;endArrow=blockThin;endFill=1;endSize=6;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="n19" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E0;strokeWidth=1;dashed=0" vertex="1" parent="1"><mxGeometry x="60" y="872" width="330" height="140" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b style='font-size:12px'&gt;Reading this diagram&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="78" y="886" width="294" height="20" as="geometry"/></mxCell><mxCell id="n36" value="" style="line;strokeColor=#4C51BF;strokeWidth=2;html=1" vertex="1" parent="1"><mxGeometry x="80" y="924" width="30" height="2" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;A2A&lt;/b&gt;&amp;nbsp; agent to agent. One contextId per trip." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="120" y="916" width="258" height="18" as="geometry"/></mxCell><mxCell id="n38" value="" style="line;strokeColor=#2C7A7B;strokeWidth=2;html=1" vertex="1" parent="1"><mxGeometry x="80" y="956" width="30" height="2" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;MCP&lt;/b&gt;&amp;nbsp; agent to tools. One server, four clients." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10.5;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="120" y="948" width="258" height="18" as="geometry"/></mxCell><mxCell id="n40" value="Every agent also persists its A2A tasks to PostgreSQL, and appends to the audit trail in TinyDB." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="80" y="972" width="292" height="34" as="geometry"/></mxCell><mxCell id="n41" value="MCP gives an agent its tools.&amp;nbsp;&amp;nbsp;A2A lets agents give each other work." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=12.5;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="210" y="1024" width="1210" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Trip sequence"><mxGraphModel dx="1820" dy="1180" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="How one trip is booked" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontStyle=1;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="40" width="700" height="34" as="geometry"/></mxCell><mxCell id="n2" value="Every arrow is an A2A message. All of them carry the same contextId." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="74" width="900" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Traveller&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0AEC0;fontColor=#1A202C;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;fontSize=13" vertex="1" parent="1"><mxGeometry x="342" y="130" width="156" height="46" as="geometry"/></mxCell><mxCell id="n4" value="" style="line;direction=north;strokeColor=#CBD5E0;strokeWidth=1.5;dashed=1;dashPattern=4 4;html=1" vertex="1" parent="1"><mxGeometry x="419" y="192" width="2" height="888" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Concierge&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#4C51BF;fontColor=#2A2F86;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;fontSize=13" vertex="1" parent="1"><mxGeometry x="592" y="130" width="156" height="46" as="geometry"/></mxCell><mxCell id="n6" value="" style="line;direction=north;strokeColor=#CBD5E0;strokeWidth=1.5;dashed=1;dashPattern=4 4;html=1" vertex="1" parent="1"><mxGeometry x="669" y="192" width="2" height="888" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Skyline&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FE;strokeColor=#2B6CB0;fontColor=#1A4E85;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;fontSize=13" vertex="1" parent="1"><mxGeometry x="862" y="130" width="156" height="46" as="geometry"/></mxCell><mxCell id="n8" value="" style="line;direction=north;strokeColor=#CBD5E0;strokeWidth=1.5;dashed=1;dashPattern=4 4;html=1" vertex="1" parent="1"><mxGeometry x="939" y="192" width="2" height="888" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Hearth&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2E3;strokeColor=#B7791F;fontColor=#8A5A12;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6;fontSize=13" vertex="1" parent="1"><mxGeometry x="1082" y="130" width="156" height="46" as="geometry"/></mxCell><mxCell id="n10" value="" style="line;direction=north;strokeColor=#CBD5E0;strokeWidth=1.5;dashed=1;dashPattern=4 4;html=1" vertex="1" parent="1"><mxGeometry x="1159" y="192" width="2" height="888" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Sentinel&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap