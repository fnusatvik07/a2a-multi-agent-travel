<mxfile host="app.diagrams.net" type="device" agent="atlastrip-make-diagrams"><diagram name="Architecture"><mxGraphModel dx="1500" dy="1060" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="AtlasTrip" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#1A202C;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="40" width="600" height="34" as="geometry"/></mxCell><mxCell id="n2" value="Five agents on five frameworks, cooperating over the A2A protocol" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=13;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="60" y="74" width="800" height="22" as="geometry"/></mxCell><mxCell id="n3" value="CALLER" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1" vertex="1" parent="1"><mxGeometry x="40" y="150" width="150" height="24" as="geometry"/></mxCell><mxCell id="n4" value="ORCHESTRATION" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1" vertex="1" parent="1"><mxGeometry x="40" y="290" width="150" height="24" as="geometry"/></mxCell><mxCell id="n5" value="SPECIALISTS" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1" vertex="1" parent="1"><mxGeometry x="40" y="500" width="150" height="24" as="geometry"/></mxCell><mxCell id="n6" value="TOOL PLANE" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1" vertex="1" parent="1"><mxGeometry x="40" y="760" width="150" height="24" as="geometry"/></mxCell><mxCell id="n7" value="DATA PLANE" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#5A6675;strokeColor=none;fillColor=none;letterSpacing=1" vertex="1" parent="1"><mxGeometry x="40" y="920" width="150" height="24" as="geometry"/></mxCell><mxCell id="n8" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Any A2A client&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;The CLI, a web app, another agent. It knows one URL and reads one Agent Card.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0AEC0;fontColor=#1A202C;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="605" y="130" width="420" height="84" as="geometry"/></mxCell><mxCell id="n9" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Concierge&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;LangGraph&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Reads the request, commissions the specialists, renegotiates what policy rejects, assembles the itinerary.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0FF;strokeColor=#4C51BF;fontColor=#2A2F86;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="555" y="268" width="520" height="118" as="geometry"/></mxCell><mxCell id="n10" value=":8000" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1083" y="268" width="60" height="20" as="geometry"/></mxCell><mxCell id="n11" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Skyline&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;Google ADK&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Sources and ranks flights.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F1FE;strokeColor=#2B6CB0;fontColor=#1A4E85;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="220" y="478" width="272" height="132" as="geometry"/></mxCell><mxCell id="n12" value=":8001" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="220" y="614" width="272" height="18" as="geometry"/></mxCell><mxCell id="n13" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Hearth&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;CrewAI&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Finds a stay near the venue.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDF2E3;strokeColor=#B7791F;fontColor=#8A5A12;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="526" y="478" width="272" height="132" as="geometry"/></mxCell><mxCell id="n14" value=":8002" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="526" y="614" width="272" height="18" as="geometry"/></mxCell><mxCell id="n15" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Sentinel&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;LlamaIndex&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Rules on policy and entry.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E9F6EC;strokeColor=#2F855A;fontColor=#1F5F40;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="832" y="478" width="272" height="132" as="geometry"/></mxCell><mxCell id="n16" value=":8003" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="832" y="614" width="272" height="18" as="geometry"/></mxCell><mxCell id="n17" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Ledger&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;Pydantic AI&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Authorises the spend.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDECF2;strokeColor=#B83280;fontColor=#8B2160;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="1138" y="478" width="272" height="132" as="geometry"/></mxCell><mxCell id="n18" value=":8004" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1138" y="614" width="272" height="18" as="geometry"/></mxCell><mxCell id="n19" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;Travel Inventory MCP server&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;letter-spacing:0.6px;text-transform:uppercase'&gt;Model Context Protocol, streamable HTTP&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;search_flights  ·  search_hotels  ·  lookup_employee  ·  get_cost_center_budget  ·  record_commitment&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E4F5F5;strokeColor=#2C7A7B;fontColor=#1D5859;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="435" y="740" width="760" height="112" as="geometry"/></mxCell><mxCell id="n20" value=":8100/mcp" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#5A6675;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1203" y="740" width="80" height="20" as="geometry"/></mxCell><mxCell id="n21" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Flights, hotels, people, cost centres, the budget ledger, and the A2A task store.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#4A5568;fontColor=#2D3748;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="465" y="900" width="330" height="108" as="geometry"/></mxCell><mxCell id="n22" value="&lt;div style='padding:2px'&gt;&lt;b style='font-size:14px'&gt;TinyDB&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style='font-size:11px;line-height:1.45'&gt;Policy clauses, entry rules, customer sites, and the audit trail.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#4A5568;fontColor=#2D3748;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;strokeWidth=1.5;spacing=6" vertex="1" parent="1"><mxGeometry x="835" y="900" width="330" height="108" as="geometry"/></mxCell><mxCell id="n23" value="A2A  message/stream" style="edgeStyle=orthogonalEdgeStyle;rounded=